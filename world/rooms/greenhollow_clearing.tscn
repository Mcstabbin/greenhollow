[sub_resource type="ProceduralSkyMaterial" id="ProceduralSkyMaterial_uixu3"]
sky_top_color = Color(0.32, 0.58, 0.88, 1)
; Was Color(0.87, 0.92, 0.9) = Rec.709 luminance 0.91, the brightest thing in the
; game and a background element. Now 0.73, so the sky sits under the character's
; white torso instead of over it. Safe to change in isolation:
; ambient_light_sky_contribution is 0.0, so sky colour lights nothing.
sky_horizon_color = Color(0.66, 0.75, 0.78, 1)
sky_curve = 0.12
ground_bottom_color = Color(0.32, 0.4, 0.3, 1)
ground_horizon_color = Color(0.74, 0.79, 0.68, 1)

[sub_resource type="Sky" id="Sky_wiqbh"]
sky_material = SubResource("ProceduralSkyMaterial_uixu3")

[sub_resource type="Environment" id="Environment_8guup"]
background_mode = 2
sky = SubResource("Sky_wiqbh")
ambient_light_source = 2
ambient_light_color = Color(0.88, 0.91, 0.84, 1)
ambient_light_sky_contribution = 0.0
; 2.1 IS over-exposure — the white torso clips hard, which is why it reads 1.000
; on every frame. Trimming it to 1.55 was measured and REJECTED, but only just, so
; the numbers are here rather than a verdict. Across the five `clearing` angles it
; moved the character's separation from the ground behind it by +0.002/+0.031/
; +0.018/+0.033/+0.002 — a real gain, but a tenth of what albedo and depth already
; bought (+0.080 to +0.106 on the same five). Against that it costs the character
; its clipped top of range (1.000 -> 0.956-0.996), drops the whole frame another
; 8% on top of the 22% the albedo work already took out, and re-lights the blade
; tells and shadow blob, which is live combat territory. Exposure is a whole-frame
; lever: it cannot change a figure/ground RELATIONSHIP, only the level everything
; sits at. Revisit it as its own piece with the combat frames in hand.
ambient_light_energy = 2.1
reflected_light_source = 2
fog_enabled = true
fog_mode = 1
fog_light_color = Color(0.17, 0.26, 0.27, 1)
fog_density = 0.55
fog_depth_begin = 16.0
fog_depth_end = 58.0
fog_sky_affect = 0.12

