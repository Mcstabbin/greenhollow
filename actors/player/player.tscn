radius = 2.8

; Sword proportions. Character is scaled x2, so these read at twice the number:
; the blade is 0.42 -> 0.84 m on a 2.2 m character. The earlier 0.3 (0.6 m) blade
; was proportionally a dagger and a critic looking at a gameplay-camera frame
; could not find it at all.
[sub_resource type="BoxMesh" id="BoxMesh_handle"]
size = Vector3(0.06, 0.14, 0.06)

[sub_resource type="BoxMesh" id="BoxMesh_guard"]
size = Vector3(0.28, 0.05, 0.08)

[sub_resource type="BoxMesh" id="BoxMesh_blade"]
size = Vector3(0.135, 0.42, 0.045)

; Radius matched to the blade mesh's own half-width rather than kept thinner than
; it: 0.135 x 2 is a 0.27 m wide blade, so a 0.26 m capsule is the sword, not a
; generosity fudge. The previous 0.075 was a third of the mesh, which left the
; combo's second swing reaching a target in front by about a centimetre.
[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_blade"]
radius = 0.13
height = 0.46

; Markedly darker and cooler than the torso it swings across. The old
; 0.79/0.84/0.90 steel was within a few percent of the white body, so at rest the
; blade merged into the chest it hangs in front of.
[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_blade"]
resource_name = "toon_steel"
albedo_color = Color(0.42, 0.5, 0.66, 1)
roughness = 0.6
diffuse_mode = 3
specular_mode = 1

; The hot core of the orange trail, not white. A white flash on a white torso is
; invisible, which is exactly what the previous version was.
[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_blade_live"]
resource_name = "blade_live"
shading_mode = 0
albedo_color = Color(1, 0.8, 0.3, 1)

; Cyan, so "charged and waiting" can never be confused with "blade live". Two
; states, two hues, and the swing owns the warm one because it is the one that has
; to fight a green background.
[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_blade_charged"]
resource_name = "blade_charged"
shading_mode = 0
albedo_color = Color(0.12, 0.9, 1, 1)

; ALPHA_SCISSOR (transparency = 2), NOT ALPHA (1), and this one integer is the
; whole fix for "the trail reads as a lighting artefact". Godot fills the depth and
; normal-roughness buffers BEFORE the transparent pass, and
; art/shaders/outline_post.gdshader reads only those two — so a transparency = 1
; material can never be outlined, at any setting. In a world where every object
; carries a 1.3 px black contour, the one shape without one reads as a rendering
; fault. Scissored, the ribbon is in the opaque pass, writes depth, and inherits
; the same contour as the grass.
;
; ALPHA_SCISSOR rather than ALPHA_HASH on purpose: a hash dithers by discarding
; pixels, which punches holes in the DEPTH buffer, which makes the outline pass
; emit black speckle across the whole ribbon. sword_trail.gd therefore never emits
; partial vertex alpha; it fades geometrically instead.
[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_trail"]
resource_name = "sword_trail"
transparency = 2
alpha_scissor_threshold = 0.5
shading_mode = 0
vertex_color_use_as_albedo = true
albedo_color = Color(1, 1, 1, 1)
cull_mode = 2
disable_receive_shadows = true

; Width against age along the ribbon: 0 is the tail, 1 the newest sample at the
; blade. Without a taper the ribbon is a parallelogram; with one it is a crescent.
; The tail keeps 26% of the width rather than going to zero, because a true point
; is one pixel wide and disappears before the outline can contour it.
[sub_resource type="Curve" id="Curve_trail_width"]
_data = [Vector2(0, 0.26), 0.0, 0.0, 0, 0, Vector2(0.45, 0.78), 0.0, 0.0, 0, 0, Vector2(1, 1), 0.0, 0.0, 0, 0]
point_count = 3

; `rings` is the subdivision of the MAIN circle and `ring_segments` the tube's
; cross-section, not the other way round. At rings = 4 this drew a diamond, which
; is what the first capture showed.
[sub_resource type="TorusMesh" id="TorusMesh_spin"]
inner_radius = 0.76
outer_radius = 1.0
rings = 32
ring_segments = 6

; Scissored for the same reason as the trail: transparency = 1 could never be
; outlined. spin_ring.gd no longer animates opacity — it holds full strength and
; then goes, which is what the reference material recommends anyway.
[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_ring"]
resource_name = "spin_ring"
transparency = 2
alpha_scissor_threshold = 0.5
shading_mode = 0
albedo_color = Color(1, 0.5, 0.08, 1)
cull_mode = 2
disable_receive_shadows = true

; The charge tell's ground ring. Authored at radius 1 so the script's scale IS the
; radius, and slightly thicker in section than the spin's so it still reads at the
; smaller settled radius.
[sub_resource type="TorusMesh" id="TorusMesh_charge"]
inner_radius = 0.78
outer_radius = 1.0
rings = 32
ring_segments = 6

; Deep teal, and deliberately DARKER than the grass it lies on (Rec.709 luminance
; ~0.33 against grass 0.47) rather than brighter. The charged blade and its light
; wash are the bright half of this tell; the ring is the dark half, so the pair
; carries its own contrast instead of borrowing it from the background, and both
; halves survive a greyscale check. Cyan-family, because cyan already means
; "charged" here and orange already means "swinging" — two states, two hues.
[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_charge_ring"]
resource_name = "charge_ring"
transparency = 2
alpha_scissor_threshold = 0.5
shading_mode = 0
albedo_color = Color(0, 0.44, 0.57, 1)
cull_mode = 2
disable_receive_shadows = true

