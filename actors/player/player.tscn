; The spin's ground read. Authored at radius 1 so the script's scale IS the radius.
; A child of the Player, not of Rig: the rig's root spins twice inside the clip and
; a ring does not want to inherit that.
[node name="SpinRing" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.07, 0)
visible = false
cast_shadow = 0
extra_cull_margin = 8.0
mesh = SubResource("TorusMesh_spin")
surface_material_override/0 = SubResource("ShaderMaterial_spin_ring")
script = ExtResource("19_ring")

; The charge tell's ground ring. Sits marginally higher than the spin's so the two
; can never z-fight if a charge is somehow live across a spin, and a child of the
; Player rather than of Rig so it does not inherit the spin's two revolutions.
[node name="ChargeRing" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.09, 0)
visible = false
cast_shadow = 0
extra_cull_margin = 8.0
mesh = SubResource("TorusMesh_charge")
surface_material_override/0 = SubResource("ShaderMaterial_charge_ring")
script = ExtResource("20_chargering")

