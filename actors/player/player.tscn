; The sword hangs off the right arm, which is a plain Node3D — character.glb has
; no Skeleton3D, so there is no bone to attach to and no BoneAttachment3D needed.
; Everything below is in Character-local units; Character is scaled x2, so the
; blade's 0.28 reads as 0.56 m and the whole sword as ~0.84 m.
[node name="SwordGrip" type="Node3D" parent="Rig/Character/character/root/torso/arm-right"]
position = Vector3(-0.26, 0, 0.02)
rotation = Vector3(0, 0.436332, 0.244346)

[node name="Handle" type="MeshInstance3D" parent="Rig/Character/character/root/torso/arm-right/SwordGrip"]
