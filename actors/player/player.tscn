; Sword proportions. Character is scaled x2, so these read at twice the number:
; the blade is 0.42 -> 0.84 m on a 2.2 m character. The earlier 0.3 (0.6 m) blade
; was proportionally a dagger and a critic looking at a gameplay-camera frame
; could not find it at all.
[sub_resource type="BoxMesh" id="BoxMesh_handle"]
size = Vector3(0.06, 0.14, 0.06)

[sub_resource type="BoxMesh" id="BoxMesh_guard"]
size = Vector3(0.28, 0.05, 0.08)

[sub_resource type="BoxMesh" id="BoxMesh_blade"]
size = Vector3(0.135, 0.42, 0.045)

; Radius matched to the blade mesh's own half-width rather than kept thinner than
; it: 0.135 x 2 is a 0.27 m wide blade, so a 0.26 m capsule is the sword, not a
; generosity fudge. The previous 0.075 was a third of the mesh, which left the
; combo's second swing reaching a target in front by about a centimetre.
[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_blade"]
radius = 0.13
height = 0.46

; Markedly darker and cooler than the torso it swings across. The old
; 0.79/0.84/0.90 steel was within a few percent of the white body, so at rest the
; blade merged into the chest it hangs in front of.
[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_blade"]
resource_name = "toon_steel"
albedo_color = Color(0.42, 0.5, 0.66, 1)
roughness = 0.6
diffuse_mode = 3
specular_mode = 1

; The hot core of the orange trail, not white. A white flash on a white torso is
; invisible, which is exactly what the previous version was.
[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_blade_live"]
resource_name = "blade_live"
shading_mode = 0
albedo_color = Color(1, 0.8, 0.3, 1)

; Cyan, so "charged and waiting" can never be confused with "blade live". Two
; states, two hues, and the swing owns the warm one because it is the one that has
; to fight a green background.
[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_blade_charged"]
resource_name = "blade_charged"
shading_mode = 0
albedo_color = Color(0.12, 0.9, 1, 1)

; ALPHA_SCISSOR (transparency = 2), NOT ALPHA (1), and this one integer is the
; whole fix for "the trail reads as a lighting artefact". Godot fills the depth and
; normal-roughness buffers BEFORE the transparent pass, and
; art/shaders/outline_post.gdshader reads only those two — so a transparency = 1
; material can never be outlined, at any setting. In a world where every object
; carries a 1.3 px black contour, the one shape without one reads as a rendering
; fault. Scissored, the ribbon is in the opaque pass, writes depth, and inherits
; the same contour as the grass.
;
; ALPHA_SCISSOR rather than ALPHA_HASH on purpose: a hash dithers by discarding
; pixels, which punches holes in the DEPTH buffer, which makes the outline pass
; emit black speckle across the whole ribbon. sword_trail.gd therefore never emits
; partial vertex alpha; it fades geometrically instead.
[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_trail"]
resource_name = "sword_trail"
transparency = 2
alpha_scissor_threshold = 0.5
shading_mode = 0
vertex_color_use_as_albedo = true
albedo_color = Color(1, 1, 1, 1)
cull_mode = 2
disable_receive_shadows = true

; How much of the ribbon's full width is open along its length: 0 is the tail, 1 the
; newest sample at the blade. Without a taper the ribbon is a parallelogram.
;
; sword_trail.gd takes the width INWARD from a fixed outer edge, so this curve also
; decides how much of a swept circle stays hollow — which is why the tail is 0.26 where
; the old symmetric model needed 0.4. Under that model a thin tail was a thin sliver at
; the SHOULDER, inside the silhouette, and it cost slash_b's first live frame; taken
; inward from the leading arc the same fraction sits at the tip's radius instead, well
; outside the body, so it is both smaller and more visible. The full span is 1.80 blade
; lengths, i.e. 1.66 m, so the tail is 0.43 m and the head 1.61 m — roughly 21 and 78 px
; at the capture size. A band, not a scratch.
;
; These three numbers were settled by measurement, not taste. The ribbon's screen
; footprint was counted by capturing the same frozen frame with the trail shown and
; hidden and differencing: against the old fan it is 14% smaller on the spin and 12%
; smaller on a slash. A more aggressive curve (0.24 / 0.54 / 0.92) reached 17-19% and
; was rejected — it left slash_b's first live frame, the one a chest already eats, with
; a single sliver where this keeps two. Structure is what the critic was complaining
; about, and structure is carried by the hollow centre and the gaps; area is secondary,
; and legibility is not negotiable.
[sub_resource type="Curve" id="Curve_trail_width"]
_data = [Vector2(0, 0.26), 0.0, 0.0, 0, 0, Vector2(0.5, 0.58), 0.0, 0.0, 0, 0, Vector2(1, 0.97), 0.0, 0.0, 0, 0]
point_count = 3

; `rings` is the subdivision of the MAIN circle and `ring_segments` the tube's
; cross-section, not the other way round. At rings = 4 this drew a diamond, which
; is what the first capture showed.
[sub_resource type="TorusMesh" id="TorusMesh_spin"]
inner_radius = 0.76
outer_radius = 1.0
rings = 48
ring_segments = 6

; Three bands across the width rather than one flat orange, matching the ribbon's own
; core/mid/rim ramp so the spin's ground footprint and its arc read as one effect. A
; single mid-value albedo (the old Color(1, 0.5, 0.08) is 0.58 luminance against
; 0.47 grass) borrows its contrast from the background; a near-white core between dark
; rims carries its own. Unbroken — `segment_fill` 1.0 — because the footprint is a
; claim about reach and a dotted line is a weaker claim.
[sub_resource type="ShaderMaterial" id="ShaderMaterial_spin_ring"]
resource_name = "spin_ring"
shader = ExtResource("21_groundring")
shader_parameter/core_colour = Color(1, 0.86, 0.62, 1)
shader_parameter/rim_colour = Color(0.3, 0.1, 0.03, 1)
shader_parameter/ring_radius = 0.88
shader_parameter/tube_radius = 0.12
shader_parameter/core_width = 0.56
shader_parameter/segments = 1.0
shader_parameter/segment_fill = 1.0

; The charge tell's ground ring. Authored at radius 1 so the script's scale IS the
; radius. Thicker in section than it was (tube 0.16, not 0.11) because it has to hold
; three bands at the smaller settled radius: 0.32 mesh units at radius 1.35 is 0.43 m,
; about 21 px at the capture size, which a core and two rims can divide and still be
; seen. At the old 0.22 the rims were sub-pixel.
[sub_resource type="TorusMesh" id="TorusMesh_charge"]
inner_radius = 0.68
outer_radius = 1.0
rings = 48
ring_segments = 6

; The charge tell, rebuilt after a blind critic called the old dark-teal version
; quiet: "dark teal ring on mid-green grass is low contrast ... a wind-up needs to be
; the loudest moment, not the softest".
;
; The previous note here argued the ring should be the DARK half of the tell and the
; blade the bright half, and cited authored albedo to prove the contrast: ring 0.33
; luminance against grass 0.47. Those numbers were measured on the wrong image. In a
; RENDERED frame the grass is lit and the ring is `unshaded`, so the light multiplier
; applies to one and not the other: sampled off a capture, the grass beside the player
; is 0.78 luminance, not 0.47. Authored albedo systematically understates how bright
; this world is, and any effect judged against 0.47 is being judged against a value
; that never reaches the screen.
;
; Re-measured, the old ring's value contrast was in fact fine (0.36 against 0.78) and
; the diagnosis was wrong: what it lacked was AREA, a bright element, and a shape that
; is not a reticle. So the band is wider, and it now carries both halves of the ramp
; itself — a 0.94-luminance icy core between 0.16-luminance rims, sampled at 0.945 and
; 0.16 in the capture — which is the bright-core-plus-dark-edge structure
; PRIOR-ART-VISUAL.md prescribes. It cannot lose against a light ground or a dark one.
;
; Cut into seven arcs, because the same critic said an unbroken ring "reads as a
; selection circle or a targeting reticle rather than energy gathering" — and it was
; right, a closed circle around a character IS a reticle. Arcs converging inward are
; not.
;
; Still cyan-family: cyan means "charged" here and orange means "swinging", so the two
; states can never be confused with each other.
[sub_resource type="ShaderMaterial" id="ShaderMaterial_charge_ring"]
resource_name = "charge_ring"
shader = ExtResource("21_groundring")
shader_parameter/core_colour = Color(0.82, 1, 1, 1)
shader_parameter/rim_colour = Color(0.02, 0.15, 0.21, 1)
shader_parameter/ring_radius = 0.84
shader_parameter/tube_radius = 0.16
shader_parameter/core_width = 0.6
shader_parameter/segments = 7.0
shader_parameter/segment_fill = 0.72

