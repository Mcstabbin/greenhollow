[node name="Blade" type="MeshInstance3D" parent="Rig/Character/character/root/torso/arm-right/SwordGrip"]
position = Vector3(0, 0.35, 0)
material_override = SubResource("StandardMaterial3D_blade")
cast_shadow = 0
mesh = SubResource("BoxMesh_blade")

; Layer 5 player_hitbox, mask 6 enemy_hurtbox. Armed only by the clips'
; _anim_hitbox_on keyframe; monitoring is off at rest.
