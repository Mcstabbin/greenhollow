position = Vector3(0, 0.14, 0)

[node name="BladeTip" type="Node3D" parent="Rig/Character/character/root/torso/arm-right/SwordGrip"]
position = Vector3(0, 0.6, 0)

; Cyan to match blade_charged, and bright enough to tint the grass — the charge
; threshold has to be visible as well as audible, and a 2.2-energy light was not.
[node name="ChargeGlow" type="OmniLight3D" parent="Rig/Character/character/root/torso/arm-right/SwordGrip"]
position = Vector3(0, 0.36, 0)
visible = false
light_color = Color(0.5, 0.96, 1, 1)
light_energy = 4.0
shadow_enabled = false
omni_range = 1.4

[node name="GroundMarker" type="MeshInstance3D" parent="Rig"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.03, 0)
cast_shadow = 0
mesh = SubResource("SphereMesh_shadow")
surface_material_override/0 = ExtResource("3_blob")

; Ours rather than the .glb's, with root_node on the Player: player_anims.tres
; keys Rig/Character/... paths, and its attack clips carry method tracks that
; call straight back onto this node.
[node name="AnimPlayer" type="AnimationPlayer" parent="."]
root_node = NodePath("..")
libraries = {
&"": ExtResource("5_anims")
}

; callback_mode_process = PHYSICS and callback_mode_method = IMMEDIATE: the attack
; windows are method tracks, so they have to land on physics ticks and fire
; without a deferred hop, or the measured wind-up drifts with framerate.
[node name="AnimationTree" type="AnimationTree" parent="."]
root_node = NodePath("..")
tree_root = SubResource("BlendTree_root")
anim_player = NodePath("../AnimPlayer")
callback_mode_process = 0
callback_mode_method = 1
active = true

; The `node_paths=PackedStringArray(...)` header is load-bearing, and its absence
; is silent: without it Godot stores the NodePath but never resolves it into a
; Node, so every transition reference arrives as null and the player simply never
; leaves Idle. Verified by packing the same wiring in code and reading back what
; the engine writes.
[node name="StateMachine" type="Node" parent="." node_paths=PackedStringArray("initial_state")]
script = ExtResource("9_machine")
initial_state = NodePath("Idle")

[node name="Idle" type="Node" parent="StateMachine" node_paths=PackedStringArray("attack_state", "move_state", "air_state")]
script = ExtResource("10_idle")
attack_state = NodePath("../Attack")
move_state = NodePath("../Move")
air_state = NodePath("../Air")

[node name="Move" type="Node" parent="StateMachine" node_paths=PackedStringArray("attack_state", "idle_state", "air_state")]
script = ExtResource("11_move")
attack_state = NodePath("../Attack")
idle_state = NodePath("../Idle")
air_state = NodePath("../Air")

[node name="Air" type="Node" parent="StateMachine" node_paths=PackedStringArray("idle_state", "move_state")]
script = ExtResource("12_air")
idle_state = NodePath("../Idle")
move_state = NodePath("../Move")

[node name="Attack" type="Node" parent="StateMachine" node_paths=PackedStringArray("idle_state", "move_state", "air_state")]
script = ExtResource("13_attack")
idle_state = NodePath("../Idle")
move_state = NodePath("../Move")
air_state = NodePath("../Air")

