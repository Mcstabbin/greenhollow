; One equip slot, and everything the player holds arrives through it. `grip` needs the
; node_paths header for the same reason the state machine's exports do: without it
; Godot stores the NodePath and never resolves it, the reference arrives null, and the
; only symptom is an empty hand.
;
; `catalogue` is the canonical item order. Two things read it and neither has its own
; copy: the debug cycle key (F4), and any chest whose own `contains` list is empty.
[node name="Loadout" type="Node" parent="." node_paths=PackedStringArray("grip")]
script = ExtResource("6_loadout")
grip = NodePath("../Rig/Character/character/root/torso/arm-right/SwordGrip")
starting_item = ExtResource("7_sword")
catalogue = Array[ItemData]([ExtResource("7_sword"), ExtResource("22_axe"), ExtResource("23_bow"), ExtResource("24_shield")])

[node name="Rig" type="Node3D" parent="."]

[node name="Character" parent="Rig" instance=ExtResource("2_character")]
transform = Transform3D(2, 0, 0, 0, 2, 0, 0, 0, 2, 0, 0, 0)

; The GRIP, and nothing else. Whatever is equipped is instanced under here by the
; Loadout below, so this node is the one thing the player scene knows about holding a
; weapon — the meshes, the hitbox, the trail markers and the charge glow all arrive
; with the item.
;
; It hangs off the right arm, which is a plain Node3D: character.glb has no
; Skeleton3D, so there is no bone to attach to and no BoneAttachment3D needed. Units
; are Character-local and Character is scaled x2, so a 0.42 blade reads as 0.84 m.
;
; Its rotation is keyed by EVERY clip in player_anims.tres, locomotion included (see
; tools/build_combat_anims.gd, GRIP_REST) — a node driven by only some clips snaps
; back to whatever the last one left it at, which once had the idle clip cancelling
; the sword's angle entirely. The rotation below is therefore only what the editor
; shows before anything plays.
[node name="SwordGrip" type="Node3D" parent="Rig/Character/character/root/torso/arm-right"]
position = Vector3(-0.26, 0, 0.02)
rotation = Vector3(0, 0.436332, 0.244346)

[node name="GroundMarker" type="MeshInstance3D" parent="Rig"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.03, 0)
cast_shadow = 0
mesh = SubResource("SphereMesh_shadow")
surface_material_override/0 = ExtResource("3_blob")

; Ours rather than the .glb's, with root_node on the Player: player_anims.tres
; keys Rig/Character/... paths, and its attack clips carry method tracks that
; call straight back onto this node.
[node name="AnimPlayer" type="AnimationPlayer" parent="."]
root_node = NodePath("..")
libraries = {
&"": ExtResource("5_anims")
}

; callback_mode_process = PHYSICS and callback_mode_method = IMMEDIATE: the attack
; windows are method tracks, so they have to land on physics ticks and fire
; without a deferred hop, or the measured wind-up drifts with framerate.
[node name="AnimationTree" type="AnimationTree" parent="."]
root_node = NodePath("..")
tree_root = SubResource("BlendTree_root")
anim_player = NodePath("../AnimPlayer")
callback_mode_process = 0
callback_mode_method = 1
active = true

; The `node_paths=PackedStringArray(...)` header is load-bearing, and its absence
; is silent: without it Godot stores the NodePath but never resolves it into a
; Node, so every transition reference arrives as null and the player simply never
; leaves Idle. Verified by packing the same wiring in code and reading back what
; the engine writes.
[node name="StateMachine" type="Node" parent="." node_paths=PackedStringArray("initial_state")]
script = ExtResource("9_machine")
initial_state = NodePath("Idle")

[node name="Idle" type="Node" parent="StateMachine" node_paths=PackedStringArray("attack_state", "aim_state", "block_state", "move_state", "air_state")]
script = ExtResource("10_idle")
attack_state = NodePath("../Attack")
aim_state = NodePath("../Aim")
block_state = NodePath("../Block")
move_state = NodePath("../Move")
air_state = NodePath("../Air")

[node name="Move" type="Node" parent="StateMachine" node_paths=PackedStringArray("attack_state", "aim_state", "block_state", "idle_state", "air_state")]
script = ExtResource("11_move")
attack_state = NodePath("../Attack")
aim_state = NodePath("../Aim")
block_state = NodePath("../Block")
idle_state = NodePath("../Idle")
air_state = NodePath("../Air")

[node name="Air" type="Node" parent="StateMachine" node_paths=PackedStringArray("idle_state", "move_state")]
script = ExtResource("12_air")
idle_state = NodePath("../Idle")
move_state = NodePath("../Move")

[node name="Attack" type="Node" parent="StateMachine" node_paths=PackedStringArray("idle_state", "move_state", "air_state")]
script = ExtResource("13_attack")
idle_state = NodePath("../Idle")
move_state = NodePath("../Move")
air_state = NodePath("../Air")

; Both new states are reachable only while the matching item is equipped, which is
; decided by ItemData.is_shield()/is_ranged() in PlayerLocomotionState — not by a name
; check on the item. Adding a fifth weapon needs no edit here.
