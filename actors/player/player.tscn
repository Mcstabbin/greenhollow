[sub_resource type="AnimationNodeStateMachineTransition" id="trans_loco"]
xfade_time = 0.12
switch_mode = 0
advance_mode = 1

[sub_resource type="AnimationNodeStateMachineTransition" id="trans_jump"]
xfade_time = 0.08
switch_mode = 0
advance_mode = 1

; Almost a cut, and the number is measured rather than chosen for feel. The charge
; threshold is a discrete event with an audible cue on the same frame, so the pose
; wants to arrive with it — but more importantly, the AnimationTree will not START a
; new travel while the current state is still fading in. A player who releases the
; instant the chime plays therefore releases INTO this fade, and every frame of it
; is added to the spin's wind-up: at 0.06 s the trace showed the travel to
; spin_attack blocked for three frames and spin_windup measured 200 ms instead of
; 150 ms. At 0.02 s the block is one frame. Traced frame by frame; see the report in
; the commit that added the charge clip.
[sub_resource type="AnimationNodeStateMachineTransition" id="trans_charge"]
xfade_time = 0.02
switch_mode = 0
advance_mode = 1

; 0.02, down from 0.05, and this is a READABILITY change with no timing cost. The
; frame the AnimationTree first reports as `slash_a` is the frame a wind-up gets
; judged on, and at that instant the new clip's blend weight is roughly one physics
; step divided by the xfade: 33% at 0.05 s, 83% at 0.02 s. At 33% the anticipation
; pose the generator now keys on frame 0 was mostly blended away, which is precisely
; the "a forearm raised one body-width ... is not enough" complaint. Verified with the
; combat probe: every measured number — wind-up 133 ms, live 100 ms, commitment
; 417 ms, spin 167/300, and all four damage counts — is bit-identical either side of
; this change, because method tracks fire on the clip's own time and blend weight has
; no say in it.
[sub_resource type="AnimationNodeStateMachineTransition" id="trans_attack_in"]
xfade_time = 0.02
switch_mode = 0
advance_mode = 1

; Same reasoning for the chained follow-up: at 0.06 s the second swing's wind-up was
; 28% expressed on the frame it is judged.
[sub_resource type="AnimationNodeStateMachineTransition" id="trans_combo"]
xfade_time = 0.03
switch_mode = 0
advance_mode = 1

[sub_resource type="AnimationNodeStateMachineTransition" id="trans_attack_out"]
xfade_time = 0.12
switch_mode = 0
advance_mode = 1

