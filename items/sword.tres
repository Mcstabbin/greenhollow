[gd_resource type="Resource" script_class="MeleeWeapon" load_steps=10 format=3]

; THE REFERENCE WEAPON, and every number here is a measurement rather than a taste.
;
; The sword existed as nodes inside actors/player/player.tscn and as constants inside
; actors/player/player.gd before it existed as data, so this file has one job before it
; has any other: reproduce that behaviour EXACTLY. tools/probe.gd's combat suite pins
; nineteen values, and equipping this through components/loadout.gd has to leave all
; nineteen bit-identical. If one moves, the refactor is wrong — that is the strongest
; test available that the data model describes the game rather than approximating it.
;
; So: 133/100/417 ms are the measured wind-up, live window and commitment of `slash_a`
; as tools/build_combat_anims.gd keyframes it, ms_charge is 1050 because that is what
; player.gd's charge_time was and the threshold quantises to 1066.7 ms at 60 Hz, and the
; hitbox capsule is 0.13 x 0.46 rather than the generator's 0.13 x 0.42 because the
; missing 4 cm is more than the margin by which the combo's second swing reaches a
; target standing in front of the player.

[ext_resource type="Script" path="res://items/melee_weapon.gd" id="1_melee"]
[ext_resource type="Script" path="res://items/attack_step.gd" id="2_step"]
[ext_resource type="Script" path="res://addons/health_hitbox_hurtbox/resources/health_action.gd" id="3_action"]
[ext_resource type="PackedScene" path="res://items/weapons/sword.tscn" id="4_scene"]

; affect 1 = Health.Affect.DAMAGE, type 2 = HealthActionType.Enum.KINETIC. Written as
; an action rather than a bare integer because that is what the vendored addon speaks:
; a hurtbox can carry a per-type HealthModifier, so "resistant to kinetic damage" is
; already expressible without this file knowing anything about it.
[sub_resource type="Resource" id="Action_slash"]
script = ExtResource("3_action")
affect = 1
type = 2
amount = 1

[sub_resource type="Resource" id="Action_spin"]
script = ExtResource("3_action")
affect = 1
type = 2
amount = 2

[sub_resource type="Resource" id="Step_slash_a"]
script = ExtResource("2_step")
clip = &"slash_a"
actions = Array[HealthAction]([SubResource("Action_slash")])
ms_windup = 133
ms_active = 100
ms_commitment = 417
cancel_window = 0.375
knockback = 0.6
ms_hitstop = 80

; The return stroke. Identical numbers, opposite arc — the difference between the two
; swings is which way they travel across the screen, which is authored in the clip.
[sub_resource type="Resource" id="Step_slash_b"]
script = ExtResource("2_step")
clip = &"slash_b"
actions = Array[HealthAction]([SubResource("Action_slash")])
ms_windup = 133
ms_active = 100
ms_commitment = 417
cancel_window = 0.375
knockback = 0.6
ms_hitstop = 80

; The spin. Deliberately outside the light-attack bands in every direction: a slower
; tell because it is a 360-degree sweep, a live window three times as long because the
; blade really is out there for two revolutions, and a 650 ms commitment because that is
; the price of having charged.
[sub_resource type="Resource" id="Step_spin"]
script = ExtResource("2_step")
clip = &"spin_attack"
actions = Array[HealthAction]([SubResource("Action_spin")])
ms_windup = 167
ms_active = 300
ms_commitment = 650
cancel_window = 0.4
knockback = 1.0
ms_hitstop = 100

[resource]
script = ExtResource("1_melee")
id = &"sword"
display_name = "Sword"
found_text = "A sword!  Swing it with the left mouse button, and hold to spin."
hand = 0
scene = ExtResource("4_scene")
steps = Array[AttackStep]([SubResource("Step_slash_a"), SubResource("Step_slash_b")])
charged = SubResource("Step_spin")
ms_charge = 1050
hot_mesh = &"Blade"
hitbox_radius = 0.13
hitbox_height = 0.46
trail_tint = Color(1, 0.44, 0.04, 1)
ms_trail = 200
